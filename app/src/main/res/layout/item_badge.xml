<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/badgeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/badge_card_bg">

    <TextView
        android:id="@+id/badgeIcon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:gravity="center"
        android:text="🏅"
        android:textSize="30sp"
        android:background="@drawable/badge_circle_bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <TextView
            android:id="@+id/badgeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badge Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/badgeCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Savings"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#777777"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/badgeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badge description"
            android:textSize="14sp"
            android:textColor="#555555"
            android:paddingTop="4dp" />

    </LinearLayout>

</LinearLayout>